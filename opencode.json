{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "instructions": [
    "AGENTS.md",
    "docs/specs/AGENT_TEAM_SPEC.md",
    "docs/specs/API_CONTRACT.md",
    "docs/specs/DATABASE_SCHEMA.md"
  ],
  "permission": {
    "bash": {
      "*": "ask",
      "git *": "allow",
      "gh *": "allow",
      "gh run *": "allow",
      "git status*": "allow",
      "git log*": "allow",
      "git diff*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "git remote*": "allow",
      "git rev-parse*": "allow",
      "git ls-files*": "allow",
      "git fetch*": "allow",
      "git pull*": "allow",
      "git checkout*": "allow",
      "git switch*": "allow",
      "git stash*": "allow",
      "git add*": "allow",
      "git commit*": "allow",
      "docker *": "allow",
      "docker compose*": "allow",
      "docker ps*": "allow",
      "docker logs*": "allow",
      "docker images*": "allow",
      "docker inspect*": "allow",
      "docker version*": "allow",
      "docker info*": "allow",
      "docker stats*": "allow",
      "docker build*": "allow",
      "docker pull*": "allow",
      "docker network*": "allow",
      "docker volume*": "allow",
      "docker exec*": "allow",
      "docker compose config*": "allow",
      "ls*": "allow",
      "pwd*": "allow",
      "whoami*": "allow",
      "hostname*": "allow",
      "uname*": "allow",
      "df*": "allow",
      "du*": "allow",
      "free*": "allow",
      "ps*": "allow",
      "which*": "allow",
      "whereis*": "allow",
      "file*": "allow",
      "stat*": "allow",
      "cat*": "allow",
      "head*": "allow",
      "head *": "allow",
      "tail*": "allow",
      "tail *": "allow",
      "less*": "allow",
      "wc*": "allow",
      "echo*": "allow",
      "echo *": "allow",
      "printf*": "allow",
      "touch*": "allow",
      "mkdir*": "allow",
      "cp*": "allow",
      "mv*": "allow",
      "ln*": "allow",
      "find*": "allow",
      "grep*": "allow",
      "rg*": "allow",
      "fd*": "allow",
      "sed*": "allow",
      "awk*": "allow",
      "cut*": "allow",
      "sort*": "allow",
      "uniq*": "allow",
      "tr*": "allow",
      "jq*": "allow",
      "yq*": "allow",
      "tar*": "allow",
      "unzip*": "allow",
      "zip*": "allow",
      "curl*": "allow",
      "wget*": "allow",
      "env*": "allow",
      "printenv*": "allow",
      "id*": "allow",
      "python*": "allow",
      "python3*": "allow",
      "pip*": "allow",
      "uv*": "allow",
      "pytest*": "allow",
      "ruff*": "allow",
      "node*": "allow",
      "npm*": "allow",
      "npx*": "allow",
      "npm run typecheck*": "allow",
      "yarn*": "allow",
      "pnpm*": "allow",
      "bun*": "allow",
      "make*": "allow",
      "chmod +x*": "allow",
      "timeout*": "allow",
      "true*": "allow",
      "false*": "allow",
      "sleep*": "allow",
      "test*": "allow",
      "git push*": "ask",
      "sudo *": "ask",
      "rm -rf*": "ask",
      "docker system prune*": "ask"
    }
  },
  "mcp": {
    "github": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "-e",
        "GITHUB_READ_ONLY",
        "-e",
        "GITHUB_TOOLSETS",
        "ghcr.io/github/github-mcp-server"
      ],
      "enabled": true,
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_TOKEN}",
        "GITHUB_READ_ONLY": "1",
        "GITHUB_TOOLSETS": "repos,code_security"
      }
    },
    "postgres": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-postgres", "{env:DATABASE_URL_PLAIN}"],
      "enabled": true,
      "environment": {}
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": true,
      "environment": {}
    },
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": true,
      "environment": {}
    }
  }
}
