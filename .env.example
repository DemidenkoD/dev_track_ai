# ==============================================================================
# DevTrack AI — Environment Configuration Template
# Copy this file to .env and populate secrets before running.
# ==============================================================================

# --- Application & Authentication (Single Predefined Account) ---
APP_ENV=development
SECRET_KEY=change-me-in-production-use-64-char-hex
ADMIN_USERNAME=reviewer@datatalks.club
ADMIN_PASSWORD=devtrack-zoomcamp-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database (PostgreSQL) ---
POSTGRES_USER=devtrack
POSTGRES_PASSWORD=devtrack_secret
POSTGRES_DB=devtrack_ai
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://devtrack:devtrack_secret@db:5432/devtrack_ai

# --- Gemini LLM ---
# DIAGNOSIS NOTE (Track 6): the placeholder below is INTENTIONALLY treated as
# "not configured" by is_gemini_configured() (backend/app/agents/base.py), so
# a VPS .env copied from this template without replacing the key boots FINE
# but silently uses deterministic fallback — zero calls in the Google
# dashboard while the app looks healthy. Injection is via compose
# `environment:` only (image WORKDIR /code has no .env file). Never commit or
# log the real key. VPS fix runbook: infra/RUNBOOK_GEMINI_VPS.md.
# `make check-prod-env` reports GEMINI_API_KEY_SET=true/false (boolean only).
GEMINI_API_KEY=your_gemini_api_key_here
# Default model: Gemma 4 31B-IT via Gemini API (same GEMINI_API_KEY) —
# avoids Gemini RPD/RPM limits encountered with gemini-2.5-flash.
GEMINI_MODEL=gemma-4-31b-it

# --- OpenCode / opencode.ai inference gateway (optional LLM backend) ---
# OPENCODE_API_KEY or OPENCODE_KEY (either) configures opencode; IF present
# takes precedence per LLM_PROVIDER (auto order: GLM(direct) > OPENCODE > GEMINI;
# LLM_PROVIDER=opencode pins gateway even if GLM_* keys present).
# OPENCODE_MODEL options (model pass-through to inference gateway):
# kimi-k2.6 (user example) | glm-5.3-flash | muse-spark-1.3-contributor.
# GLM via opencode gateway (uses OPENCODE_API_KEY/OPENCODE_KEY, no separate Z.AI key):
# OPENCODE_MODEL=glm-5.3-flash + LLM_PROVIDER=opencode to pin.
OPENCODE_API_KEY=your_opencode_api_key_here
OPENCODE_KEY=your_opencode_key_here
OPENCODE_MODEL=muse-spark-1.3-contributor
# Default opencode.ai OpenAI-compatible inference endpoint.
OPENCODE_BASE_URL=https://opencode.ai/inference/openai/v1

# --- LLM Provider Selection ---
# LLM_PROVIDER: auto|glm|opencode|gemini. auto order: GLM(direct) > OPENCODE > GEMINI.
# LLM_PROVIDER=opencode forces gateway (for GLM-via-opencode) even if GLM_* keys present.
LLM_PROVIDER=auto

# --- GLM / Zhipu (OpenAI-compatible) ---
# Precedence when LLM_PROVIDER=auto: GLM_API_KEY (or ZAI_API_KEY alias) > OPENCODE_KEY > GEMINI_API_KEY.
GLM_API_KEY=your_glm_key_here
# ZAI_API_KEY is an alias for GLM_API_KEY (same Z.ai key); set either one.
ZAI_API_KEY=
GLM_MODEL=glm-5.3-flash
GLM_BASE_URL=https://api.z.ai/api/paas/v4/

# --- GitHub Integration (Optional token for higher public rate limits) ---
GITHUB_TOKEN=

# --- One-Time Email Notifications (In-Memory Only, Never Persisted) ---
MAIL_SMTP_HOST=smtp.example.com
MAIL_SMTP_PORT=465
MAIL_SMTP_SECURE=true
MAIL_SMTP_USER=user@example.com
MAIL_SMTP_PASS=your_smtp_password_here
MAIL_FROM=DevTrack AI <user@example.com>
MAIL_BASE_URL=http://localhost:8000

# --- Worker & Resource Limits ---
WORKER_POLL_INTERVAL_SECONDS=5
ANALYSIS_TIMEOUT_SECONDS=300
MAX_REPO_SIZE_MB=250

# --- Observability (OpenTelemetry & Grafana) ---
OTEL_SERVICE_NAME=devtrack-ai-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=devtrack-zoomcamp-2026


